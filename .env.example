# Repository GenTether is allowed to index. Defaults to the bundled demo fixture.
GENTETHER_REPO=./fixtures/checkout-app
PORT=8787

# Set both values to make HydraDB the live graph engine.
HYDRA_URL=http://127.0.0.1:8443
HYDRA_TOKEN=local-development-token-32-bytes
HYDRA_NAMESPACE=default
HYDRA_GRAPH=default
HYDRA_CELL_ID=cell-0
